POSTGRES_DB=recipe_app
POSTGRES_USER=recipe_app
POSTGRES_PASSWORD=replace-this-with-a-local-password
POSTGRES_PORT=5432

# Neon development: `neon deploy` / `neon env pull` writes actual values to the
# ignored root .env. Keep these server-only; never use VITE_ prefixes.
# DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require&channel_binding=require
# NEON_BRANCH=production
# AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH_STORAGE_ENDPOINT
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=YOUR_STORAGE_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_STORAGE_SECRET_KEY
# The root dev:api and smoke:neon scripts select recipe-images-dev explicitly.

# Password reset email (API). Not read by docker compose; set via .NET User Secrets locally, e.g.
#   dotnet user-secrets set "Smtp:Host" "smtp.example.com" --project apps/api/src/RecipeApp.Api
# Keys: Smtp:Host, Smtp:Port, Smtp:From, Smtp:Username, Smtp:Password, Smtp:EnableSsl, PasswordReset:PublicBaseUrl
# With no Smtp:Host in Development, reset links are written to the API log instead of emailed.
