@baseUrl = https://localhost:7209
@email = user@example.com
@password =
@ingredientId = 00000000-0000-7000-8000-000000000000

### Sign in first; the HTTP client stores the session cookie for later requests
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### List the current user's categories
GET {{baseUrl}}/api/categories

### Create a category (or return its existing normalized match)
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "Pantry"
}

### Invalid category name (400)
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "   "
}

### List the current user's departments
GET {{baseUrl}}/api/departments

### Create a department (or return its existing normalized match)
POST {{baseUrl}}/api/departments
Content-Type: application/json

{
  "name": "Produce"
}

### List seeded supermarket chains and stores
GET {{baseUrl}}/api/supermarkets

### List active ingredients (page size 25 by default)
GET {{baseUrl}}/api/ingredients?page=1&pageSize=25&archived=false

### Search active ingredients by name
GET {{baseUrl}}/api/ingredients?search=apple&page=1&pageSize=25&archived=false

### Request a page beyond the last page (400 Problem Details)
GET {{baseUrl}}/api/ingredients?page=999&pageSize=25

### Read one owned ingredient by ID
GET {{baseUrl}}/api/ingredients/{{ingredientId}}
